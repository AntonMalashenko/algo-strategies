"""scripts/s007_loop.py -- the Python scheduler that replaced scripts/s007_loop.sh
after the 2026-07-22/23 incident (a bash `sleep` that never woke for ~17h; see
decisions-log.md). Covers the pure decision logic (in_session/decide_action,
no I/O, no sleeping) and run_cycle's STATUS-line parsing / failure handling.
Does not test main()'s real loop end-to-end (that would need real sleeping or
extensive mocking of time.sleep) -- decide_action is the unit that carries the
actual scheduling behavior, and main() is a thin driver over it.
"""
from __future__ import annotations

import datetime
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from scripts.s007_loop import (  # noqa: E402
    IDLE_POLL_SECONDS, POLL_SECONDS, _parse_status_line, decide_action,
    in_session, run_cycle,
)


def _dt(y, m, d, hh, mm):
    return datetime.datetime(y, m, d, hh, mm)


# --- in_session -------------------------------------------------------------

def test_in_session_true_during_weekday_trading_hours():
    assert in_session(_dt(2026, 7, 22, 12, 0)) is True     # Wed noon


def test_in_session_false_on_weekend():
    assert in_session(_dt(2026, 7, 25, 12, 0)) is False    # Sat
    assert in_session(_dt(2026, 7, 26, 12, 0)) is False    # Sun


def test_in_session_false_before_trade_start():
    assert in_session(_dt(2026, 7, 22, 9, 59)) is False


def test_in_session_true_at_exit_end_hour():
    # EXIT_END="16:59" -- the whole 16:xx hour still counts as in-session.
    assert in_session(_dt(2026, 7, 22, 16, 59)) is True


def test_in_session_false_after_exit_end_hour():
    assert in_session(_dt(2026, 7, 22, 17, 0)) is False


# --- decide_action -----------------------------------------------------------

def test_decide_action_runs_when_in_session_and_not_settled():
    plan = decide_action(_dt(2026, 7, 22, 12, 0), settled_today=None)
    assert plan == dict(run=True, sleep=POLL_SECONDS, settled_today=None)


def test_decide_action_skips_and_idles_outside_session():
    plan = decide_action(_dt(2026, 7, 22, 20, 0), settled_today=None)
    assert plan["run"] is False
    assert plan["sleep"] == IDLE_POLL_SECONDS


def test_decide_action_skips_once_settled_today_even_if_in_session():
    today = datetime.date(2026, 7, 22)
    plan = decide_action(_dt(2026, 7, 22, 14, 0), settled_today=today)
    assert plan["run"] is False
    assert plan["settled_today"] == today


def test_decide_action_resets_settled_flag_on_a_new_day():
    stale = datetime.date(2026, 7, 21)   # yesterday's settled marker
    plan = decide_action(_dt(2026, 7, 22, 12, 0), settled_today=stale)
    assert plan["run"] is True
    assert plan["settled_today"] is None


# --- _parse_status_line / run_cycle -----------------------------------------

def test_parse_status_line_extracts_booleans():
    stdout = "cycle done: 0 actions\nSTATUS day_done=False in_window=True filtered=True actions=0\n"
    fields = _parse_status_line(stdout)
    assert fields == dict(day_done=False, in_window=True, filtered=True, actions="0")


def test_parse_status_line_missing_returns_empty():
    assert _parse_status_line("some unrelated crash traceback\n") == {}


def test_run_cycle_returns_parsed_status_on_success(monkeypatch):
    def fake_run(*a, **k):
        return subprocess.CompletedProcess(
            args=a, returncode=0,
            stdout="STATUS day_done=True in_window=True filtered=False actions=2\n", stderr="")
    monkeypatch.setattr(subprocess, "run", fake_run)
    result = run_cycle()
    assert result["day_done"] is True
    assert result["filtered"] is False


def test_run_cycle_returns_empty_on_timeout(monkeypatch):
    def fake_run(*a, **k):
        raise subprocess.TimeoutExpired(cmd="bot.s007_paper", timeout=120)
    monkeypatch.setattr(subprocess, "run", fake_run)
    assert run_cycle() == {}


def test_run_cycle_returns_empty_on_crash_before_status_line(monkeypatch):
    def fake_run(*a, **k):
        return subprocess.CompletedProcess(args=a, returncode=1, stdout="", stderr="Traceback...\n")
    monkeypatch.setattr(subprocess, "run", fake_run)
    # A crash never treated as settled -- next poll must try again, not stop for today.
    assert run_cycle() == {}
