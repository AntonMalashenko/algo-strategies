# Copy to .env (already gitignored) and fill in real values. Never commit
# .env or echo its values -- see webapp/crypto.py and the security notes in
# .claude/skills/webapp/SKILL.md.

# Fernet-encrypts/decrypts Account.credentials in the DB. Must be the SAME
# key already used to encrypt existing rows in data/app.db, or every stored
# credential becomes unreadable. Long random string.
APP_SECRET_KEY=

# Only needed if overriding the default sqlite:///data/app.db (e.g. Postgres
# later). docker-compose.yml sets the in-container SQLite path itself
# (sqlite:////app/data/app.db) -- leave this unset for local Docker use.
# APP_DB_URL=

# Redis connection (utils/redis_client.py). docker-compose.yml sets this to
# redis://redis:6379 on the Ofelia job-run worker containers itself -- leave
# it unset for local Docker use. Redis is NOT published to the host, so
# setting this for a process running directly on the host has no effect
# (the container-only `redis` hostname won't resolve there).
# REDIS_URL=redis://redis:6379

# Capital.com REST API, read-only use by mt5/tools/s021_capital.py (the standalone
# S021 order-price calculator for trading by hand on a Capital.com account). The key
# and its custom password are created together in the platform under
# Settings > API integrations; the identifier is the account email. CAPITAL_DEMO=0
# switches to the live endpoint -- the tool only reads prices either way.
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_DEMO=1

# Telegram bot used for operational messages (utils/telegram.py; the S021 manual tools
# push the order prices there with --telegram). Create the bot with @BotFather, put the
# token here, say Start to the bot, then run `python -m utils.telegram` -- it prints the
# TELEGRAM_CHAT_ID line to paste below and sends a test message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
